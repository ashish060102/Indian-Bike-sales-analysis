          <datasource-dependencies datasource='federated.1idx07p17kpgme1gkm1hn1pq9t39'>
            <column caption='Bike Age' datatype='integer' name='[Calculation_1156580701105905664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR(TODAY()) - [Year of Manufacture]' />
            </column>
            <column caption='Calculated Resale Price' datatype='real' default-format='c&quot;₹ &quot;#,##0.00;&quot;₹ &quot;-#,##0.00' name='[Calculation_1156580701106151425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Fuel Type] = &quot;Electric&quot; THEN&#13;&#10;&#13;&#10;    IF [Calculation_1156580701105905664] &lt;= 0 THEN&#13;&#10;        [Price (INR)]&#13;&#10;    ELSE&#13;&#10;        [Price (INR)] * 0.8 * (0.9 ^ ([Calculation_1156580701105905664] - 1))&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    /* Petrol / Diesel: 10–15% per year (12% avg) */&#13;&#10;    [Price (INR)] * (0.88 ^ [Calculation_1156580701105905664])&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Fuel Type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Price (INR)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Seller Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column datatype='integer' name='[Year of Manufacture]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1156580701106151425]' derivation='Avg' name='[avg:Calculation_1156580701106151425:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Fuel Type]' derivation='None' name='[none:Fuel Type:nk]' pivot='key' type='nominal' />
